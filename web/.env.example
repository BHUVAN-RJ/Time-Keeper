# Copy to .env.local and fill. Never commit .env.local.
# For Vercel: copy to .env.production, fill prod values, import in Vercel UI (also gitignored).

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

RESEND_API_KEY=
AUTH_RESEND_FROM=onboarding@resend.dev

# Google Calendar (read-only, Settings → Connect)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64-encoded: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
